{
    "name": "chlaedderi",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "packageManager": "pnpm@11.22.0",
    "browserslist": [
        "Firefox >= 128",
        "last 2 Chrome versions",
        "last 2 Safari versions",
        "iOS >= 16"
    ],
    "scripts": {
        "dev": "vite",
        "build": "tsc && tsc -p tsconfig.node.json && vite build",
        "preview": "vite preview",
        "test": "vitest",
        "lint": "tsc && tsc -p tsconfig.node.json && prettier --check src e2e eslint.config.mjs vite.config.ts playwright.config.ts && eslint --max-warnings 0 .",
        "lint:fix": "prettier --write src e2e eslint.config.mjs vite.config.ts playwright.config.ts && eslint --max-warnings 0 --fix .",
        "e2e": "playwright test",
        "screens": "playwright test e2e/screens.spec.ts"
    },
    "dependencies": {
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fontsource/barlow": "^5.3.0",
        "@fontsource/barlow-condensed": "^5.3.0",
        "@mui/icons-material": "^9.5.0",
        "@mui/material": "^9.5.0",
        "@mui/x-charts": "^9.15.0",
        "@reduxjs/toolkit": "^2.13.0",
        "ajv": "^8.20.0",
        "ajv-formats": "^3.0.1",
        "date-fns": "^4.4.0",
        "i18next": "^26.4.2",
        "leaflet": "^1.9.4",
        "leaflet.markercluster": "^1.5.3",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-i18next": "^17.0.16",
        "react-leaflet": "^5.0.0",
        "react-redux": "^9.3.0",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "1.61.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/leaflet": "^1.9.22",
        "@types/leaflet.markercluster": "^1.5.6",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.1",
        "@typescript-eslint/parser": "^8.71.1",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.13.0",
        "jsdom": "^30.1.2",
        "prettier": "^3.9.9",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.4",
        "vite-plugin-pwa": "^2.0.0",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^5.0.3",
        "workbox-window": "^7.4.1"
    }
}
