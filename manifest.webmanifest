{
  "name": "Chlädderi",
  "short_name": "Chlädderi",
  "description": "Karte und Liste von Sportklettergebieten – mit Parkplätzen, Zustiegen, Navigation, Wetter, Regen-Info, Logbuch und Favoriten. Die Gebiete kommen als Mappack dazu.",
  "lang": "de",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "launch_handler": { "client_mode": ["navigate-existing", "auto"] },
  "background_color": "#28157a",
  "theme_color": "#28157a",
  "categories": ["sports", "travel", "navigation"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Favoriten", "short_name": "Favoriten", "url": "./#/fav", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Logbuch", "short_name": "Logbuch", "url": "./#/log", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "related_applications": [{ "platform": "webapp", "url": "manifest.webmanifest" }]
}
