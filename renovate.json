{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "security:openssf-scorecard"
  ],
  "enabledManagers": ["npm", "github-actions", "custom.regex"],
  "branchPrefix": "renovate/",
  "schedule": ["before 6am on sunday"],
  "major": {
    "schedule": ["before 6am on the first day of the month"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "prCreation": "immediate"
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "groupName": "App dependencies"
    },
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "Dev dependencies"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Keep the pnpm version in the packageManager field up to date",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"packageManager\"\\s*:\\s*\"pnpm@(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "pnpm",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Raise a reminder to run `devenv update` when a devenv input moves",
      "managerFilePatterns": ["/^devenv\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) packageName=(?<packageName>.*?) currentValue=(?<currentValue>.*?)\\s"
      ]
    }
  ]
}
